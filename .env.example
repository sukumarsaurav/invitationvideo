# Copy to .env.local. Local values come from `supabase status` after `npm run db:start`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=paste-the-local-anon-key-here

# Set to true once a Google OAuth app is configured in Supabase (Auth > Providers > Google).
VITE_GOOGLE_AUTH_ENABLED=false

# Support WhatsApp number, digits only with country code (e.g. 919876543210). Unset = link hidden.
VITE_SUPPORT_WHATSAPP=

# Public base URL for template assets and renders (MinIO locally, R2 in production).
VITE_ASSET_BASE_URL=http://127.0.0.1:9000/invitationvideos

# Razorpay test key id (public). The secret lives only in Edge Function secrets.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
