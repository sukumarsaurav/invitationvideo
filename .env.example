# Copy to .env.local for `npm run dev`. There is no local database: development uses the hosted
# Supabase project, so drafts, sign-ins and admin changes made while developing are real data.
# Values: Supabase dashboard → Project Settings → API Keys (the publishable key is public).
VITE_SUPABASE_URL=https://clhfqyyqjwcrgpfrplyy.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_paste-the-key-here

# Set to true once a Google OAuth app is configured in Supabase (Auth > Providers > Google).
VITE_GOOGLE_AUTH_ENABLED=false

# HD downloads without payment. Always on in development; in production leave unset (only paid
# videos can be downloaded) unless you deliberately want free downloads, e.g. a launch promotion.
VITE_FREE_HD=

# Fallback support WhatsApp number (digits with country code). The admin panel's Settings wins.
VITE_SUPPORT_WHATSAPP=

# Razorpay key id (public), for Phase 2. The secret lives only in Edge Function secrets.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
